    <RootNamespace>Singulink.UI.Navigation.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Strong-named, since the strong-named Singulink.UI.Navigation only grants friend access to assemblies signed with its key. -->
