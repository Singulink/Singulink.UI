<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Packages that ship together share a version: the navigation packages, the icon packages and the XAML packages. -->
  <PropertyGroup Label="Package Versions">
    <NavigationVersion>7.4.0</NavigationVersion>
    <IconsVersion>1.3.0</IconsVersion>
    <XamlVersion>3.9.0</XamlVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Singulink</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>© Singulink. All rights reserved.</Copyright>
    <PackageIcon>Singulink Icon 128x128.png</PackageIcon>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>

    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsAotCompatible>true</IsAotCompatible>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageProjectUrl>https://github.com/Singulink/Singulink.UI</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Uno.Sdk would otherwise give each library a module initializer that sets the app's default font to OpenSans
       (https://github.com/unoplatform/uno/issues/25635). -->
  <PropertyGroup Condition="'$(UsingUnoSdk)' == 'true'">
    <UnoDefaultFont>None</UnoDefaultFont>
  </PropertyGroup>

  <PropertyGroup Label="Strong Naming">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)key.snk</AssemblyOriginatorKeyFile>
    <!-- The key's public key, which the SDK adds to InternalsVisibleTo items: a strong-named assembly can only name strong-named friends. -->
    <PublicKey></PublicKey>

    <!-- CS8002: Uno Platform's assemblies (SkiaSharp's Uno views included) aren't strong-named. That's harmless, since .NET doesn't validate strong
         names or use them for binding. Remove this if Uno ships strong-named assemblies. The WinAppSDK target doesn't reference Uno, so it keeps the
         warning. -->
    <NoWarn Condition="'$(UsingUnoSdk)' == 'true' AND !$(TargetFramework.Contains('windows10'))">$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup Label="Source Link" Condition="'$(Configuration)' == 'Release'">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\Resources\Singulink Icon 128x128.png" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>
