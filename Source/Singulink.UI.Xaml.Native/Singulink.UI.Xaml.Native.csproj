<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Deliberately a plain (non-Uno.Sdk) library: on Skia-rendered Uno heads, the Uno SDK swaps referenced
         Uno-flavored library assemblies for their single Skia (desktop) build, which strips out any
         platform-conditional code. This library is invisible to that swap, so its platform-specific
         assemblies load as-built and Uno libraries (e.g. Singulink.UI.Xaml.WinUI) can route native
         platform behavior through it. -->
    <TargetFrameworks>net10.0;net10.0-ios</TargetFrameworks>
    <RootNamespace>Singulink.UI.Xaml</RootNamespace>

    <Version>3.5.0</Version>
    <PackageTags>WinUI; Uno Platform; XAML; Behaviors; iOS;</PackageTags>
    <Description>Platform-native helpers for Singulink WinUI 3 / Uno Platform XAML extensions.</Description>
  </PropertyGroup>
</Project>
