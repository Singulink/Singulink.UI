<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- ;net9.0-desktop -->
    <TargetFrameworks>net10.0-windows10.0.26100;net10.0-desktop;net10.0-browserwasm</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Suppress not implemented in Uno warnings -->
    <NoWarn>$(NoWarn);Uno0001;</NoWarn>
    <!-- Uno.WinUI.DevServer disables the assembly version attributes in Debug builds (a hot reload workaround), which trips CA1016. -->
    <NoWarn Condition="'$(Configuration)' == 'Debug'">$(NoWarn);CA1016</NoWarn>
    <!-- The platform analyzer calls Uno's WebAssembly target 'browserwasm' while the JavaScript interop APIs are annotated 'browser'. -->
    <NoWarn Condition="$(TargetFramework.Contains('browserwasm'))">$(NoWarn);CA1416</NoWarn>
    <!-- Uno's own assemblies produce trim warnings (IL2104) when the WebAssembly head is published; they must not fail the publish. -->
    <ILLinkTreatWarningsAsErrors Condition="$(TargetFramework.Contains('browserwasm'))">false</ILLinkTreatWarningsAsErrors>
    <!-- The WebAssembly head is embedded in the VS Code extension's webview, where the app is not served from a site root, so emit relative paths. -->
    <WasmShellWebAppBasePath Condition="$(TargetFramework.Contains('browserwasm'))">./</WasmShellWebAppBasePath>
    <!-- Neutral dark splash so the WebAssembly loader does not flash white; inside VS Code the page overrides it with the editor background. -->
    <UnoSplashScreenColor>#202020</UnoSplashScreenColor>

    <!-- Display name -->
    <ApplicationTitle>Singulink Icon Pack Builder</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.singulink.IconPackBuilder</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Singulink</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Utility to build trimmed font-based icon packs.</Description>
    <!--
      If you encounter this error message:

        error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
        Please update to a newer .NET SDK in order to reference this assembly.

      This means that the two packages below must be aligned with the "build" version number of
      the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
      must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <WindowsSdkPackageVersion>10.0.22621.28</WindowsSdkPackageVersion> -->

    <!--
      UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Toolkit;
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\Source\Singulink.UI.Navigation.WinUI\Singulink.UI.Navigation.WinUI.csproj" />
    <ProjectReference Include="..\..\Source\Singulink.UI.Xaml.WinUI\Singulink.UI.Xaml.WinUI.csproj" />
    <ProjectReference Include="..\IconPackBuilder.Core\IconPackBuilder.Core.csproj" />
    <ProjectReference Include="..\IconPackBuilder.ViewModels\IconPackBuilder.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('browserwasm'))">
    <!-- Uno.Sdk only embeds AppManifest.js by default; the bootstrapper runs every embedded WasmScripts/*.js before the app starts. -->
    <EmbeddedResource Include="Platforms\WebAssembly\WasmScripts\ipbBrowserHost.js" />
  </ItemGroup>

  <Import Project="Tools\PyFtSubset.targets" />
</Project>
