<Project>

  <!--
    Bundles single-file pyftsubset binaries into the app's Tools/<rid> folders.

    Binaries are built by the "Build pyftsubset binaries" GitHub Actions workflow and published as assets of the
    "pyftsubset-v<fonttools version>" release. The Windows x64 binary is committed to the repo; other platforms are
    downloaded into obj/ on first build. By default only the binary for the build host (or the RuntimeIdentifier being
    published) is bundled; set PyFtSubsetAllPlatforms=true (used for the dotnet tool package) to bundle all of them, or
    PyFtSubsetRids to a ';'-separated list to choose explicitly.
  -->

  <PropertyGroup>
    <PyFtSubsetVersion Condition="'$(PyFtSubsetVersion)' == ''">4.64.0</PyFtSubsetVersion>
    <PyFtSubsetReleaseUrl Condition="'$(PyFtSubsetReleaseUrl)' == ''">https://github.com/Singulink/Singulink.UI/releases/download/pyftsubset-v$(PyFtSubsetVersion)</PyFtSubsetReleaseUrl>
    <PyFtSubsetRids Condition="'$(PyFtSubsetRids)' == '' and '$(PyFtSubsetAllPlatforms)' == 'true'">win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</PyFtSubsetRids>
  </PropertyGroup>

  <PropertyGroup>
    <_PyFtApplies>true</_PyFtApplies>
    <_PyFtApplies Condition="$(TargetFramework.Contains('browserwasm'))">false</_PyFtApplies>
  </PropertyGroup>

  <ItemGroup Condition="'$(_PyFtApplies)' == 'true'">
    <None Update="Tools\*\pyftsubset;Tools\*\pyftsubset.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="ResolvePyFtSubsetBinaries" BeforeTargets="AssignTargetPaths" Condition="'$(_PyFtApplies)' == 'true'">
    <PropertyGroup>
      <_PyFtArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_PyFtArch>
      <_PyFtArch>$(_PyFtArch.ToLowerInvariant())</_PyFtArch>
      <_PyFtHostRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-$(_PyFtArch)</_PyFtHostRid>
      <_PyFtHostRid Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-$(_PyFtArch)</_PyFtHostRid>
      <_PyFtHostRid Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-$(_PyFtArch)</_PyFtHostRid>
      <PyFtSubsetRids Condition="'$(PyFtSubsetRids)' == ''">$(RuntimeIdentifier)</PyFtSubsetRids>
      <PyFtSubsetRids Condition="'$(PyFtSubsetRids)' == ''">$(_PyFtHostRid)</PyFtSubsetRids>
      <_PyFtDownloadRoot>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)pyftsubset\$(PyFtSubsetVersion)\</_PyFtDownloadRoot>
    </PropertyGroup>

    <ItemGroup>
      <!-- Metadata is built up in steps because an Update cannot reference metadata it defines itself. -->
      <_PyFtRid Include="$(PyFtSubsetRids)" />
      <_PyFtRid Update="@(_PyFtRid)">
        <Rid>%(Identity)</Rid>
        <ExeExt></ExeExt>
      </_PyFtRid>
      <_PyFtRid Update="@(_PyFtRid)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('win'))">
        <ExeExt>.exe</ExeExt>
      </_PyFtRid>
      <_PyFtRid Update="@(_PyFtRid)">
        <Exe>pyftsubset%(ExeExt)</Exe>
        <CommittedFile>$(MSBuildThisFileDirectory)%(Rid)\pyftsubset%(ExeExt)</CommittedFile>
        <DownloadedFile>$(_PyFtDownloadRoot)%(Rid)\pyftsubset%(ExeExt)</DownloadedFile>
      </_PyFtRid>
      <!-- Committed binaries are picked up by the None glob above; everything else is downloaded. -->
      <_PyFtDownload Include="@(_PyFtRid)" Condition="!Exists('%(CommittedFile)')" />
    </ItemGroup>

    <DownloadFile Condition="'@(_PyFtDownload)' != '' and !Exists('%(_PyFtDownload.DownloadedFile)')"
                  SourceUrl="$(PyFtSubsetReleaseUrl)/pyftsubset-%(_PyFtDownload.Rid)%(_PyFtDownload.ExeExt)"
                  DestinationFolder="$(_PyFtDownloadRoot)%(_PyFtDownload.Rid)"
                  DestinationFileName="%(_PyFtDownload.Exe)"
                  ContinueOnError="WarnAndContinue" />

    <Warning Condition="'@(_PyFtDownload)' != '' and !Exists('%(_PyFtDownload.DownloadedFile)')"
             Text="pyftsubset binary for '%(_PyFtDownload.Rid)' is not available. Exporting on that platform will fall back to 'pyftsubset' on the PATH or a Python installation with fonttools." />

    <!-- Cross-building from Windows cannot set the bit; PyFtSubsetter sets it at runtime if it is missing. -->
    <Exec Condition="'@(_PyFtDownload)' != '' and Exists('%(_PyFtDownload.DownloadedFile)') and '%(_PyFtDownload.ExeExt)' == '' and !$([MSBuild]::IsOSPlatform('Windows'))"
          Command="chmod +x &quot;%(_PyFtDownload.DownloadedFile)&quot;" />

    <ItemGroup>
      <!-- Qualified metadata so batching runs over the download list rather than the existing None items. -->
      <None Include="%(_PyFtDownload.DownloadedFile)" Condition="Exists('%(_PyFtDownload.DownloadedFile)')" Link="Tools\%(_PyFtDownload.Rid)\%(_PyFtDownload.Exe)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
