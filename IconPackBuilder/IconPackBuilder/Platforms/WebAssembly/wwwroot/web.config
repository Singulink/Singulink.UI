<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <customErrors mode="Off"/>
  </system.web>

  <system.webServer>
    <!-- Disable compression as we're doing it through pre-compressed files -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" dynamicCompressionBeforeCache="false" />

    <staticContent>
      <mimeMap fileExtension=".js.gz" mimeType="application/javascript" />
      <mimeMap fileExtension=".dat.gz" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json.gz" mimeType="application/json" />
      <mimeMap fileExtension=".wasm.gz" mimeType="application/wasm" />
      <mimeMap fileExtension=".html.gz" mimeType="text/html" />
      <mimeMap fileExtension=".css.gz" mimeType="text/css" />
      <mimeMap fileExtension=".ico.gz" mimeType="image/x-icon" />
      <mimeMap fileExtension=".svg.gz" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".txt.gz" mimeType="text/plain" />
      <mimeMap fileExtension=".otf.gz" mimeType="font/otf" />
      <mimeMap fileExtension=".ttf.gz" mimeType="font/ttf" />
      <mimeMap fileExtension=".webmanifest.gz" mimeType="application/manifest+json" />

      <mimeMap fileExtension=".js.br" mimeType="application/javascript" />
      <mimeMap fileExtension=".dat.br" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json.br" mimeType="application/json" />
      <mimeMap fileExtension=".wasm.br" mimeType="application/wasm" />
      <mimeMap fileExtension=".html.br" mimeType="text/html" />
      <mimeMap fileExtension=".css.br" mimeType="text/css" />
      <mimeMap fileExtension=".ico.br" mimeType="image/x-icon" />
      <mimeMap fileExtension=".svg.br" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".txt.br" mimeType="text/plain" />
      <mimeMap fileExtension=".otf.br" mimeType="font/otf" />
      <mimeMap fileExtension=".ttf.br" mimeType="font/ttf" />
      <mimeMap fileExtension=".webmanifest.br" mimeType="application/manifest+json" />
    </staticContent>

    <rewrite>
      <rules>
        <rule name="Lookup for pre-compressed brotli file" stopProcessing="true">
          <match url="(.*)$"/>
          <conditions>
            <!-- Match brotli requests -->
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="br" />

            <!-- Don't rewrite requests that already end with .br -->
            <add input="{REQUEST_URI}" pattern="\.br$" negate="true" />

            <!-- Check if the pre-compressed .br file exists on the disk -->
            <add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
          </conditions>
          <serverVariables>
            <set name="RESPONSE_X_COMPRESSION_APPLIED" value="br" />
          </serverVariables>
          <action type="Rewrite" url="{R:0}.br" />
        </rule>

        <rule name="Lookup for pre-compressed gzip file" stopProcessing="true">
          <match url="(.*)$"/>
          <conditions>
            <!-- Match gzip requests -->
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="gzip" />

            <!-- Don't rewrite requests that already end with .gz -->
            <add input="{REQUEST_URI}" pattern="\.gz$" negate="true" />

            <!-- Check if the pre-compressed .gz file exists on the disk -->
            <add input="{REQUEST_FILENAME}.gz" matchType="IsFile" />
          </conditions>
          <serverVariables>
            <set name="RESPONSE_X_COMPRESSION_APPLIED" value="gzip" />
          </serverVariables>
          <action type="Rewrite" url="{R:0}.gz" />
        </rule>

        <rule name="SPA fallback - serve app root for client routes" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <!-- Serve existing files and directories as-is -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>

      <outboundRules>
        <rule name="Adjust content encoding for gzip pre-compressed files">
          <match serverVariable="RESPONSE_Content-Encoding" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_X_COMPRESSION_APPLIED}" pattern="^gzip$" />
          </conditions>
          <action type="Rewrite" value="gzip"/>
        </rule>

        <rule name="Adjust content encoding for brotli pre-compressed files">
          <match serverVariable="RESPONSE_Content-Encoding" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_X_COMPRESSION_APPLIED}" pattern="^br$" />
          </conditions>
          <action type="Rewrite" value="br"/>
        </rule>

        <!-- Cache control: non-2xx responses must not be cached or stored -->
        <rule name="Cache control for non-2xx responses" stopProcessing="true">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_STATUS}" pattern="^[^2]" />
          </conditions>
          <action type="Rewrite" value="no-store, no-cache, must-revalidate, max-age=0"/>
        </rule>

        <!-- Cache control: /_framework files are fingerprinted, can cache forever -->
        <rule name="Cache control for framework files" stopProcessing="true">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/_framework/" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable"/>
        </rule>

        <!-- Cache control: /package_* folders are fingerprinted, can cache forever -->
        <rule name="Cache control for package files" stopProcessing="true">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/package_" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable"/>
        </rule>

        <!-- Cache control: All other files and SPA fallbacks must always revalidate -->
        <rule name="Cache control for other files" stopProcessing="true">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="no-cache"/>
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
