<UserControl
  x:Class="IconPackBuilder.Views.EditorRoot"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:IconPackBuilder.Views"
  xmlns:vm="using:IconPackBuilder.ViewModels"
  xmlns:utu="using:Uno.Toolkit.UI"
  xmlns:suxc="using:Singulink.UI.Xaml.Converters">

  <UserControl.Resources>
    <FontFamily x:Key="SeagullIconFont">ms-appx:///Assets/Seagull/SeagullFluentIcons.otf#Seagull Fluent Icons</FontFamily>
    <!--
      Deliberately lightweight: the default Fluent Button template adds several rounded-clip visuals per tile, and on Uno's Skia renderer each
      visual pays per-frame damage-region and clip work while scrolling (unoplatform/uno#23984, #24221). One rectangular Border + ContentPresenter
      with hover/pressed states keeps the grid smooth with ~150 realized tiles.
    -->
    <Style x:Key="IconGroupTileStyle" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,280" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="10" HorizontalAlignment="Left">
      <MenuBar VerticalAlignment="Center">
        <MenuBarItem Title="File" AccessKey="F">
          <MenuFlyoutItem Text="Save" AccessKey="S" Command="{x:Bind Model.SaveProjectCommand}" Visibility="{x:Bind suxc:Visible.IfTrue(Model.ShowFileCommands)}">
            <MenuFlyoutItem.Icon>
              <FontIcon Glyph="&#xF03E4;" FontFamily="{StaticResource SeagullIconFont}" />
            </MenuFlyoutItem.Icon>
            <MenuFlyoutItem.KeyboardAccelerators>
              <KeyboardAccelerator Key="S" Modifiers="Control" />
            </MenuFlyoutItem.KeyboardAccelerators>
          </MenuFlyoutItem>
          <MenuFlyoutItem Text="Export" AccessKey="E" Command="{x:Bind Model.ExportProjectCommand}">
            <MenuFlyoutItem.Icon>
              <FontIcon Glyph="&#xF2400;" FontFamily="{StaticResource SeagullIconFont}" />
            </MenuFlyoutItem.Icon>
          </MenuFlyoutItem>
          <MenuFlyoutSubItem Text="Export Formats" AccessKey="F">
            <MenuFlyoutSubItem.Icon>
              <FontIcon Glyph="&#xF0C4C;" FontFamily="{StaticResource SeagullIconFont}" />
            </MenuFlyoutSubItem.Icon>
            <ToggleMenuFlyoutItem Text="C# Class" IsChecked="{x:Bind Model.ExportCSharp, Mode=TwoWay}" />
            <ToggleMenuFlyoutItem Text="CSS Stylesheet" IsChecked="{x:Bind Model.ExportCss, Mode=TwoWay}" />
            <ToggleMenuFlyoutItem Text="JavaScript Module" IsChecked="{x:Bind Model.ExportJavaScript, Mode=TwoWay}" />
          </MenuFlyoutSubItem>
          <MenuFlyoutItem Text="Preview" AccessKey="P" Command="{x:Bind Model.PreviewIconPackCommand}">
            <MenuFlyoutItem.Icon>
              <FontIcon Glyph="&#xF1C80;" FontFamily="{StaticResource SeagullIconFont}" />
            </MenuFlyoutItem.Icon>
          </MenuFlyoutItem>
          <MenuFlyoutSeparator Visibility="{x:Bind suxc:Visible.IfTrue(Model.ShowFileCommands)}" />
          <MenuFlyoutItem Text="Close" AccessKey="C" Command="{x:Bind Model.CloseCommand}" Visibility="{x:Bind suxc:Visible.IfTrue(Model.ShowFileCommands)}">
            <MenuFlyoutItem.Icon>
              <FontIcon Glyph="&#xF0428;" FontFamily="{StaticResource SeagullIconFont}" />
            </MenuFlyoutItem.Icon>
          </MenuFlyoutItem>
          <MenuFlyoutSeparator Visibility="{x:Bind suxc:Visible.IfTrue(Model.ShowExitCommand)}" />
          <MenuFlyoutItem Text="Exit" AccessKey="X" Command="{x:Bind Model.ExitCommand}" Visibility="{x:Bind suxc:Visible.IfTrue(Model.ShowExitCommand)}">
            <MenuFlyoutItem.Icon>
              <FontIcon Glyph="&#xF01C0;" FontFamily="{StaticResource SeagullIconFont}" />
            </MenuFlyoutItem.Icon>
          </MenuFlyoutItem>
        </MenuBarItem>
      </MenuBar>
      <TextBox PlaceholderText="Filter" VerticalAlignment="Center" Width="200"
               Text="{x:Bind Model.NameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox ItemsSource="{x:Bind Model.VariantFilters}" SelectedItem="{x:Bind Model.VariantFilter, Mode=TwoWay}" VerticalAlignment="Center" />
      <CheckBox Content="With RTL Only" IsChecked="{x:Bind Model.RtlVersionsOnlyFilter, Mode=TwoWay}" HorizontalAlignment="Center" />
      <CheckBox Content="Included Only" IsChecked="{x:Bind Model.IncludedOnlyFilter, Mode=TwoWay}" HorizontalAlignment="Center" />
      <Grid Padding="10,3" Margin="0,3" CornerRadius="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind Model.ProjectName, Mode=OneWay}" />
          <TextBlock Text="*" Visibility="{x:Bind Model.IsDirty, Mode=OneWay}" Foreground="Red" Margin="2,0,0,0" FontWeight="Bold" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <ScrollViewer x:Name="IconGroupsScrollViewer" Grid.Row="1" Grid.Column="0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
      <!-- ItemsRepeater is used instead of GridView because GridView does not virtualize on Skia. -->
      <!--
        TEMPORARY, revert to the defaults once unoplatform/uno#23984 is fixed (the #23986 backport to a 6.7.x service release).
        VerticalCacheLength defaults to 2.0, i.e. two viewports of buffer on top of the visible one, so roughly three viewports of tiles are
        realized. On Uno's Skia heads every realized visual pays per-frame damage-region work while scrolling even when it is off screen, so
        the buffer is trimmed to cut that population roughly in half. The WinAppSDK head is unaffected and scrolls smoothly either way.
        The cost of trimming is that fast scrolling can reveal empty tiles, so this is a stopgap and not a setting worth keeping long term.
        Horizontal scrolling is disabled here, so that buffer is not needed at all.
      -->
      <ItemsRepeater ItemsSource="{x:Bind Model.FilteredIconGroups, Mode=OneWay}" Margin="10,0,10,10" XYFocusKeyboardNavigation="Enabled"
                     VerticalCacheLength="0.5" HorizontalCacheLength="0">
        <ItemsRepeater.Layout>
          <UniformGridLayout MinItemWidth="168" MinItemHeight="40" MinRowSpacing="4" MinColumnSpacing="8" ItemsStretch="None" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:IconGroupModel">
            <!--
              DataContext is set explicitly because WinUI's ItemsRepeater does not set it on realized elements when the template uses compiled
              x:Bind (they inherit the UserControl's, i.e. the editor view model), which made the click handler cast the wrong type. Uno sets it,
              so this only crashed the WinAppSDK head.
            -->
            <Button Style="{StaticResource IconGroupTileStyle}" Click="OnIconGroupClick" DataContext="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind Info.Description}">
              <Grid Background="{ThemeResource ControlFillColorDefaultBrush}" Width="168" Height="40">
                <Grid Background="#2235C759" Visibility="{x:Bind suxc:Visible.IfTrue(HasSelectedIcons), Mode=OneWay}">
                  <Ellipse Width="8" Height="8" Fill="#35C759" StrokeThickness="0" Margin="4"
                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,4,14,4">
                  <FontIcon Glyph="{x:Bind ActiveIconInfo.Glyph, Mode=OneWay}" FontSize="32" Width="32" Height="32"
                            FontFamily="{utu:AncestorBinding AncestorType=UserControl, Path=IconFontFamily}" />
                  <TextBlock Text="{x:Bind Info.Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                             Width="110" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
                <Border BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}" BorderThickness="2"
                        Visibility="{x:Bind suxc:Visible.IfTrue(IsSelected), Mode=OneWay}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </ScrollViewer>

    <ContentControl Grid.Row="1" Grid.Column="1" Content="{x:Bind Model.SelectedIconGroup, Mode=OneWay}" HorizontalContentAlignment="Stretch">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:IconGroupModel">
          <StackPanel Padding="8" Spacing="8">
            <TextBlock Text="{x:Bind Info.Name}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Info.Description}" Visibility="{x:Bind suxc:Visible.IfNotNull(Info.Description)}"
                       TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
            <TextBlock Text="{x:Bind KeywordsText}" Visibility="{x:Bind suxc:Visible.IfNotNull(KeywordsText)}"
                       TextWrapping="Wrap" FontSize="11" Opacity="0.6" />
            <TextBox Header="Export name" PlaceholderText="{x:Bind Info.Id}" Text="{x:Bind ExportName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ItemsRepeater ItemsSource="{x:Bind Icons}">
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:IconModel">
                  <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <FontIcon Glyph="{x:Bind Info.Glyph}" FontSize="28" Width="28" Height="28"
                                FontFamily="{utu:AncestorBinding AncestorType=UserControl, Path=IconFontFamily}" />
                      <FontIcon Glyph="{x:Bind Info.RtlGlyph}" FontSize="28" Width="28" Height="28"
                                FontFamily="{utu:AncestorBinding AncestorType=UserControl, Path=IconFontFamily}"
                                Visibility="{x:Bind suxc:Visible.IfNotNull(Info.RtlGlyph)}" />
                      <TextBlock Text="{x:Bind Info.Variant}" VerticalAlignment="Center" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</UserControl>
