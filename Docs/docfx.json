{
  "metadata": [
    {
      "_comment": "Singulink.UI.Icons.Wpf only has Windows target frameworks and cannot be built with TargetFramework=net10.0, so it is documented from its Release assembly (built by build-and-serve.ps1). A separate metadata group for it would overwrite this group's generated api/toc.yml.",
      "properties": {
          "TargetFramework": "net10.0"
      },
      "src": [
        {
          "files": [
            "Singulink.UI.Icons/Singulink.UI.Icons.csproj",
            "Singulink.UI.Icons.WinUI/Singulink.UI.Icons.WinUI.csproj",
            "Singulink.UI.Icons.Avalonia/Singulink.UI.Icons.Avalonia.csproj",
            "Singulink.UI.Icons.Maui/Singulink.UI.Icons.Maui.csproj",
            "Singulink.UI.Navigation/Singulink.UI.Navigation.csproj",
            "Singulink.UI.Navigation.WinUI/Singulink.UI.Navigation.WinUI.csproj",
            "Singulink.UI.Navigation.Testing/Singulink.UI.Navigation.Testing.csproj",
            "Singulink.UI.Tasks/Singulink.UI.Tasks.csproj",
            "Singulink.UI.Xaml.WinUI/Singulink.UI.Xaml.WinUI.csproj",
            "Singulink.UI.Icons.Wpf/bin/Release/net10.0-windows/Singulink.UI.Icons.Wpf.dll"
          ],
          "src": "../Source"
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "memberLayout": "separatePages",
      "includeExplicitInterfaceImplementations": true,
      "disableGitFeatures": true,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "globalMetadata": {
      "_appTitle": "Singulink UI Toolkit",
      "_appName": "UI Tookit",
      "_appLogoPath": "images/logo.png",
      "_appFaviconPath": "images/favicon.png",
      "_copyrightFooter": "© Singulink. All rights reserved.",
      "_enableSearch": true,
      "_enableNewTab": true
    },
    "template": ["default", "templates/singulinkfx"],
    "xref": [ "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json" ],
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "toc.yml",
          "*.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "articles/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "apidoc/**.md"
        ],
        "exclude": [
          "obj/**",
          "_site/**"
        ]
      }
    ],
    "dest": "_site",
    "disableGitFeatures": true,
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false
  }
}
